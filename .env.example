PLANE_API_KEY=plane_api_xxx
PLANE_WEBHOOK_SECRET=plane_wh_xxx
# Taiga: либо application token, либо логин/пароль (общие или per-alias: TAIGA_USERNAME_<ALIAS>)
TAIGA_APP_TOKEN=
TAIGA_USERNAME=bot@example.com
TAIGA_PASSWORD=secret
# Секрет вебхука Taiga: та же строка, что указана в форме создания вебхука в Taiga
TAIGA_WEBHOOK_SECRET=any-random-string
# Bitrix API token (or BITRIX_API_TOKEN_<ALIAS> for a specific provider)
BITRIX_API_TOKEN=
# Ключи intake-эндпоинтов (api-провайдеры): общий или per-alias INTAKE_API_KEY_<ALIAS>
INTAKE_API_KEY=random-secret-string
# INTAKE_API_KEY_INTAKE_DEVOPS=another-secret
PACHKA_API_TOKEN=your_pachka_bot_token
PORT=3000
PLANE_NETWORK=plane_default

