# Этот файл главнее окружения: при старте значения отсюда перекрывают уже заданные переменные шелла
# (имена перекрытых пишутся в лог warning'ом). Отключить: DOTENV_OVERRIDE=false
PLANE_API_KEY=plane_api_xxx
PLANE_WEBHOOK_SECRET=plane_wh_xxx
# Taiga: либо application token, либо логин/пароль (общие или per-alias: TAIGA_USERNAME_<ALIAS>)
TAIGA_APP_TOKEN=
TAIGA_USERNAME=bot@example.com
TAIGA_PASSWORD=secret
# Секрет вебхука Taiga: та же строка, что указана в форме создания вебхука в Taiga
TAIGA_WEBHOOK_SECRET=any-random-string
# GitLab: токен со скоупом api (общий или per-alias GITLAB_TOKEN_<ALIAS>).
# Хватает group access token с ролью Developer; админский PAT нужен только чтобы искать
# исполнителя по приватному email, иначе укажите в конфиге groups или userMap.
GITLAB_TOKEN=glpat-xxx
# Secret token вебхука GitLab (Settings -> Webhooks): та же строка, что в поле Secret token
GITLAB_WEBHOOK_SECRET=any-random-string
# Токен Bitrix (общий или per-alias BITRIX_API_TOKEN_<ALIAS>)
BITRIX_API_TOKEN=
# Ключи intake-эндпоинтов (api-провайдеры): общий или per-alias INTAKE_API_KEY_<ALIAS>
INTAKE_API_KEY=random-secret-string
# INTAKE_API_KEY_INTAKE_DEVOPS=another-secret
PACHKA_API_TOKEN=your_pachka_bot_token
PORT=3000
PLANE_NETWORK=plane_default

